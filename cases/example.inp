numberOfInitialParticles   = 10000
numberOfTimeSteps          = 500
timeStepSize               = 0.1

diskRadius                 = 1
diskCutoffRadius           = 5
diskThickness              = 0.1
diskMass                   = 1
toomreStabilityParameter   = 1.5
haloMass                   = 5
haloScaleRadius            = 10
gravitationalConstant      = 1
softeningLength            = 0.03
forceAlgorithm             = BarnesHut
maxOpeningAngle            = 0.5

backend                    = CUDA

outputFilePath             = "output/"
outputFileTimestepInterval = 5